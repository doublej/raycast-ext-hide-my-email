{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "hide-my-email",
  "title": "Hide My Email",
  "description": "Generate an iCloud+ Hide My Email alias and copy it to the clipboard.",
  "icon": "command-icon.png",
  "author": "jurre_jan",
  "categories": ["Productivity", "Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "generate",
      "title": "Generate Hide My Email",
      "description": "Create a new iCloud alias and copy it to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "label",
          "placeholder": "Label",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^19.0.10",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build --skip-types -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
